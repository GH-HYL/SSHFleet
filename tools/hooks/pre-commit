#!/bin/sh
# 提交前闸门：一律交给 tools/check.sh，跑哪一段由它自己判断——
# 只改了 .md 就跑文档检查，有 .go 或手动跑就跑全套。
#
# 装在 .git/hooks/ 里才生效（bash tools/install-hooks.sh），本文件是它可追踪的那一份。

set -e

export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'

root="$(git rev-parse --show-toplevel)"
exec wsl.exe -d "${SSHFLEET_WSL_DISTRO:-Ubuntu-26.04}" --cd "$(cygpath -w "$root")" -- bash tools/check.sh
