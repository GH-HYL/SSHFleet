[
    {
        "name": "递归强制删除根目录",
        "example": "rm -rf /",
        "regex": "^\\s*rm\\s+(-[rf]+|--no-preserve-root|-(?:r\\s+f|f\\s+r))\\s*/\\s*(?:#.*)?$",
        "risk_level": "forbidden"
    },
    {
        "name": "递归强制删除系统目录",
        "example": "rm -rf /etc",
        "regex": "^\\s*rm\\s+(-[rf]+|-(?:r\\s+f|f\\s+r))\\s*/(?:etc|usr|var|lib|bin|sbin)(?:/.*)?\\s*(?:#.*)?$",
        "risk_level": "forbidden"
    },
    {
        "name": "格式化根磁盘",
        "example": "mkfs /dev/sda",
