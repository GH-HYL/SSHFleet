        "risk_level": "forbidden"
    },
    {
        "name": "销毁系统数据",
        "example": "dd if=/dev/zero of=/dev/sda",
        "regex": "^\\s*dd\\s+if=/dev/(?:zero|random)\\s+of=/dev/(sd|hd|vd)[a-z]+\\s*(?:#.*)?$",
        "risk_level": "forbidden"
    },
    {
        "name": "立即关闭系统",
